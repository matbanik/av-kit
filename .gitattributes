# Normalize text to LF in the repository; check out native line endings.
* text=auto

# Explicit binaries — never normalize.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.exe binary
*.dll binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Lockfiles are generated — collapse in diffs.
package-lock.json linguist-generated=true
uv.lock linguist-generated=true
openapi.committed.json linguist-generated=true
