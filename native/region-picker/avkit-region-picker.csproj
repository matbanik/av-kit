<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>avkit-region-picker</AssemblyName>
    <RootNamespace>AvKit.RegionPicker</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFAC010 asks us to move the DPI declaration out of app.manifest and into the
         ApplicationHighDpiMode property. We deliberately do the opposite: that property
         lowers to an Application.SetHighDpiMode call that runs after process start, while
         PerMonitorV2 must be in force before the first Screen query or bitmap allocation
         (app.manifest, and §Capture pipeline rule 1 of the MEU-40 plan). The manifest is
         the single source of truth for this process's DPI awareness. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The picker is driven by Electron, never by a user double-click; a console
         handle would flash a window, so WinExe stays and stdout is redirected by
         the parent process. -->
    <!-- DPI awareness is declared in app.manifest, NOT here: the process must already be
         PerMonitorV2 when it starts, before any Screen query. Setting the
         ApplicationHighDpiMode property as well is rejected by WFAC010, and it would be a
         runtime call that arrives too late anyway. -->
  </PropertyGroup>

</Project>
