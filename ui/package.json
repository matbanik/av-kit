{
  "name": "av-kit-ui",
  "version": "0.1.0-rc.2",
  "private": true,
  "type": "module",
  "description": "Save YouTube videos and captions, read text aloud, shrink videos and mark up screenshots, all on your own PC.",
  "license": "MIT",
  "author": "Mat Banik",
  "homepage": "https://github.com/matbanik/av-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matbanik/av-kit.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --allowOnly=false",
    "lint": "eslint src/ tests/ --max-warnings 0",
    "clean:out": "node -e \"const fs=require('fs');['out','../native/region-picker/publish'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "build:picker": "dotnet publish ../native/region-picker -c Release -r win-x64 --self-contained true -p:PublishSingleFile=false -o ../native/region-picker/publish",
    "build:picker-stub": "dotnet publish ../native/region-picker-stub -c Release -r win-x64 --self-contained false -o ../native/region-picker-stub/publish",
    "test:e2e": "node ./scripts/playwright-with-outputfile.mjs",
    "test:e2e:capture": "npx playwright test tests/e2e/capture-picker.test.ts --reporter=json",
    "dist:prep": "npm run clean:out && npm run build && npm run build:picker && npm --prefix ../mcp-server run bundle",
    "dist": "npm run dist:prep && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.166.0",
    "electron-store": "^8.2.0",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.400.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/eslint-plugin": "1.6.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.0.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
