{
  "pending": "<div class=\"flex items-center gap-3 px-3 py-2 rounded-[var(--radius-lg)] border transition-[background-color,border-color] duration-[var(--duration-fast)] ease-[var(--ease-out)] border-border bg-bg hover:bg-bg-elevated\" data-testid=\"queue-card\" data-job-id=\"j1\" data-status=\"Pending\"><div class=\"flex min-w-0 flex-1 items-center gap-3 text-left rounded-[var(--radius-md)]\"><span class=\"w-7 shrink-0 text-right text-xs tabular-nums text-fg-muted\" data-testid=\"queue-card-position\">1</span><span class=\"inline-flex items-center text-status-pending\" data-testid=\"queue-card-status-icon\" data-status=\"pending\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle h-2.5 w-2.5 fill-current\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg></span><div class=\"min-w-0 flex-1\"><p class=\"truncate text-sm text-fg\" data-testid=\"queue-card-title\" title=\"Pending job\">Pending job</p><p class=\"truncate text-xs text-fg-muted\" data-testid=\"queue-card-meta\" title=\"Waiting - position 1 in queue\">Waiting - position 1 in queue</p></div><span class=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[var(--radius-full)] text-xs font-medium whitespace-nowrap bg-status-pending/10 text-fg\" data-testid=\"status-badge\" data-status=\"pending\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle h-2 w-2 fill-current\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg>Pending</span></div></div>",
  "doneWithMenu": "<div class=\"flex items-center gap-3 px-3 py-2 rounded-[var(--radius-lg)] border transition-[background-color,border-color] duration-[var(--duration-fast)] ease-[var(--ease-out)] border-accent/50 bg-accent/5\" data-testid=\"queue-card\" data-job-id=\"j2\" data-status=\"Done\"><input aria-label=\"Select Done job\" data-testid=\"selection-checkbox\" class=\"h-4 w-4 shrink-0 cursor-pointer rounded-[var(--radius-control)] border border-border focus-visible:outline-none focus-visible:shadow-[0_0_0_3px_var(--color-accent-ring)] disabled:opacity-50 disabled:cursor-not-allowed\" style=\"accent-color: var(--color-accent);\" type=\"checkbox\" checked=\"\"><div class=\"flex min-w-0 flex-1 items-center gap-3 text-left rounded-[var(--radius-md)] cursor-pointer focus-visible:outline-none focus-visible:shadow-[0_0_0_3px_var(--color-accent-ring)]\" role=\"button\" tabindex=\"0\" aria-label=\"Open details for Done job\"><span class=\"w-7 shrink-0 text-right text-xs tabular-nums text-fg-muted\" data-testid=\"queue-card-position\">2</span><span class=\"inline-flex items-center text-status-filled\" data-testid=\"queue-card-status-icon\" data-status=\"done\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle h-2.5 w-2.5 fill-current\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg></span><div class=\"min-w-0 flex-1\"><p class=\"truncate text-sm text-fg\" data-testid=\"queue-card-title\" title=\"Done job\">Done job</p><p class=\"truncate text-xs text-fg-muted\" data-testid=\"queue-card-meta\" title=\"1 KB\">1 KB</p></div><span class=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[var(--radius-full)] text-xs font-medium whitespace-nowrap bg-status-filled/10 text-fg\" data-testid=\"status-badge\" data-status=\"done\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle h-2 w-2 fill-current\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg>Done</span></div><button type=\"button\" class=\"inline-flex items-center justify-center font-medium select-none rounded-[var(--radius-control)] transition-[background-color,border-color,color,opacity] duration-[var(--duration-fast)] ease-[var(--ease-out)] focus-visible:outline-none focus-visible:shadow-[0_0_0_3px_var(--color-accent-ring)] disabled:opacity-50 disabled:pointer-events-none bg-accent/12 text-accent hover:bg-accent/20 btn-secondary h-7 px-2.5 text-sm gap-1.5 \" aria-busy=\"false\" data-testid=\"queue-card-primary-action\" aria-label=\"Open file\" title=\"C:/out/a.mp4\">Open file</button><div class=\"relative shrink-0\"><span data-testid=\"queue-card-kebab-tip\" class=\"inline-flex\"><button type=\"button\" class=\"inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-[var(--radius-control)] text-fg-muted transition-[background-color,color] duration-[var(--duration-fast)] ease-[var(--ease-out)] hover:bg-neutral/30 hover:text-fg focus-visible:outline-none focus-visible:shadow-[0_0_0_3px_var(--color-accent-ring)]\" data-testid=\"queue-card-kebab\" aria-haspopup=\"menu\" aria-expanded=\"false\" aria-label=\"Actions for Done job\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-ellipsis-vertical h-4 w-4\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"1\"></circle><circle cx=\"12\" cy=\"5\" r=\"1\"></circle><circle cx=\"12\" cy=\"19\" r=\"1\"></circle></svg></button></span></div></div>",
  "inFlight": "<div class=\"flex items-center gap-3 px-3 py-2 rounded-[var(--radius-lg)] border transition-[background-color,border-color] duration-[var(--duration-fast)] ease-[var(--ease-out)] border-border bg-bg hover:bg-bg-elevated\" data-testid=\"queue-card\" data-job-id=\"j3\" data-status=\"Downloading\"><div class=\"flex min-w-0 flex-1 items-center gap-3 text-left rounded-[var(--radius-md)]\"><span class=\"w-7 shrink-0 text-right text-xs tabular-nums text-fg-muted\" data-testid=\"queue-card-position\">3</span><span class=\"inline-flex items-center text-accent-cyan\" data-testid=\"queue-card-status-icon\" data-status=\"downloading\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle h-2.5 w-2.5 fill-current\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg></span><div class=\"min-w-0 flex-1\"><p class=\"truncate text-sm text-fg\" data-testid=\"queue-card-title\" title=\"Running job\">Running job</p><p class=\"truncate text-xs text-fg-muted\" data-testid=\"queue-card-meta\" title=\"42% complete\">42% complete</p></div><div class=\"w-28 shrink-0\"><div class=\"relative h-1.5 w-full overflow-hidden rounded-[var(--radius-full)] bg-neutral/30\" data-testid=\"progress-bar\" role=\"progressbar\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"42\" aria-label=\"Progress for Running job\"><div class=\"absolute inset-0 bg-accent rounded-[var(--radius-full)] transition-[transform]\" data-progress-fill=\"\" style=\"transform: scaleX(0.42); transform-origin: left; transition-duration: var(--duration-normal); transition-timing-function: var(--ease-out);\"></div></div></div><span class=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[var(--radius-full)] text-xs font-medium whitespace-nowrap bg-accent-cyan/10 text-fg\" data-testid=\"status-b