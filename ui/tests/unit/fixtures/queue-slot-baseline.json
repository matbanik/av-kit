  "header": "<div data-testid=\"queue-header-row\" class=\"flex flex-wrap items-center gap-x-4 gap-y-2\"><div class=\"flex items-center gap-2 px-1 py-1.5 text-sm text-fg-muted\" data-testid=\"queue-selection-header\"><input aria-label=\"Select all downloads\" data-testid=\"queue-select-all\" class=\"h-4 w-4 shrink-0 cursor-pointer rounded-[var(--radius-control)] border border-border focus-visible:outline-none focus-visible:shadow-[0_0_0_3px_var(--color-accent-ring)] disabled:opacity-50 disabled:cursor-not-allowed\" style=\"accent-color: var(--color-accent);\" type=\"checkbox\"><span>3 items</span></div><div class=\"flex flex-wrap items-center gap-2\" data-testid=\"queue-summary\"><span class=\"inline-flex items-center gap-1 rounded-[var(--radius-full)] px-2 py-0.5 text-xs font-medium bg-status-pending/10 text-fg \" data-tone=\"warning\"><span>Pending</span><span>2</span></span><span class=\"inline-flex items-center gap-1 rounded-[var(--radius-full)] px-2 py-0.5 text-xs font-medium bg-accent-cyan/10 text-fg \" data-tone=\"info\"><span>Downloading</span><span>1</span></span><div class=\"relative\"><button type=\"button\" data-testid=\"queue-status-more\" aria-expanded=\"false\" aria-label=\"Show all queue status counts\" class=\"rounded-[var(--radius-control)] px-2 py-1 text-xs text-fg-muted hover:bg-neutral/30 focus-visible:outline-none focus-visible:shadow-[0_0_0_3px_var(--color-accent-ring)]\">More</button></div></div><span class=\"inline-flex items-center gap-1 rounded-[var(--radius-full)] px-2 py-0.5 text-xs font-medium bg-accent-cyan/10 text-fg \" data-testid=\"processor-indicator\" data-tone=\"info\"><span>Processing…</span></span><div class=\"relative inline-flex self-start\"><div class=\"flex items-center gap-1.5\" data-testid=\"queue-toolbar\" role=\"toolbar\" aria-label=\"Download queue actions\"><button type=\"button\" class=\"inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-[var(--radius-control)] text-sm text-fg transition-[background-color,color] 